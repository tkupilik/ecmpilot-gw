CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_UNICORE=n
CONFIG_FREERTOS_SMP=n
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_ESP_TIMER_TASK_AFFINITY_CPU0=y
CONFIG_FREERTOS_TIMER_TASK_AFFINITY_CPU1=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
# Reserve sockets for HTTP, GVRET listener/client, phone UDP, MQTT and DNS.
CONFIG_LWIP_MAX_SOCKETS=16

# Web task diagnostics: microsecond counters with no 32-bit (~71 min) wrap.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y

# Runtime timer service has the highest valid priority (25 levels: 0-24).
CONFIG_FREERTOS_TIMER_TASK_PRIORITY=24

# Passive CAN receiver; verify bitrate against the connected vehicle branch.
CONFIG_GW_CAN_RX_ENABLED=y
# CONFIG_GW_CAN_500K is not set
CONFIG_TWAI_ISR_IN_IRAM=y

CONFIG_GW_CAN_125K=y

CONFIG_GW_CAN_INFO=y
# CONFIG_GW_CAN_HS1 is not set

# Optional HA client stays on the network core; no PSRAM is required.
CONFIG_MQTT_TASK_CORE_SELECTION_ENABLED=y
CONFIG_MQTT_USE_CORE_0=y
CONFIG_MQTT_TASK_STACK_SIZE=6144
CONFIG_MQTT_BUFFER_SIZE=1024


CONFIG_PM_ENABLE=y

CONFIG_PM_PROFILING=y

CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y

CONFIG_ESP_SLEEP_DEBUG=y

CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3
