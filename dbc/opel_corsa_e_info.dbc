VAL_ 0 EspDisconnectRequest 0 "Connected by diagnostic tool" 1 "Disconnected by diagnostic tool" ;
VAL_ 0 BrakeAssistFaultLampRequest 0 "No ignition request" 1 "Fault lamp lighting request" ;
VAL_ 0 StaticSlopeState 0 "Low slope" 1 "Steep uphill slope" 2 "high downhill slope" 3 "Slope undefined" ;
VAL_ 0 BrakeFunctionNeedForStartStop 0 "No need, per brake function" 1 "Stop transition inhibition" 2 "Restart request" 3 "Stop and restart transition inhibited" ;
VAL_ 0 BrakeEcuPowerManagementFault 0 "No fault detected" 1 "Failure detected" ;
VAL_ 0 EmergencyBrakingSignaliza_517ee3 0 "SFU function not present in the brake ECU" 1 "SFU function present in the brake ECU" ;
VAL_ 0 BatteryVoltageUcBrake 255 "Not_available" ;
VAL_ 0 RearRightWheelSpeedSensorFault 0 "No fault on the rear right pulse counter" 1 "Rear right pulse counter fault" ;
VAL_ 0 RearLeftWheelSpeedSensorFault 0 "No fault on RRL pulse counter" 1 "Rear left pulse counter fault" ;
VAL_ 0 AbsFaultLampRequest 0 "Lamp off" 1 "Lamp on" ;
VAL_ 0 BrakeFluidLevelAlert 0 "No alert" 1 "Alert" ;
VAL_ 0 WornBrakePadsIndicator 0 "Brake pads in good condition" 1 "Brake pads worn out" ;
VAL_ 0 RefInProgress 0 "Not in regulation" 1 "In regulation" ;
